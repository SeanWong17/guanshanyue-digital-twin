{
  "name": "guanshanyue-digital-twin",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5189",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/check_solar.mjs",
    "test:browser": "node scripts/check_preview.mjs",
    "desktop": "npm run build && electron .",
    "package:win": "electron-builder --win nsis zip --x64 --publish never",
    "test:desktop": "node scripts/check_desktop.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "vite": "^6.4.3"
  },
  "main": "desktop/main.cjs",
  "description": "Guanshanyue community 3D walkthrough and sunlight simulation",
  "author": "SeanWong17",
  "build": {
    "appId": "io.github.seanwong17.guanshanyue",
    "productName": "Guanshanyue",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE",
      "licenses/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Guanshanyue-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Guanshanyue-Setup-${version}-${arch}.${ext}"
    }
  }
}
